<configuration>
    <conversionRule conversionWord="trilingualMsg" class="kz.mybrain.superkassa.core.application.common.TrilingualLogConverter" />

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %trilingualMsg%n</pattern>
        </encoder>
    </appender>

    <logger name="io.netty" level="WARN" />
    <logger name="ktor" level="INFO" />
    <!-- Клиент Ktor на уровне TRACE пишет адрес запроса целиком, а в адресе
         каналов доставки лежат телефон покупателя и токен бота: подробнее
         INFO его журнал не пускается, даже если корень опустят. -->
    <logger name="io.ktor" level="INFO" />
    <logger name="com.openhtmltopdf" level="ERROR" />

    <root level="INFO">
        <appender-ref ref="CONSOLE" />
    </root>
</configuration>
